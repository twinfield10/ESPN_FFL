# --- Secrets -------------------------------------------------------------
# Patterns, not literal filenames. This previously listed exactly
# "config.yaml" and "gs4creds.json", so a copy or rename (config_2026.yaml,
# creds.json) would have been committed silently. Note that "*.env" does NOT
# match a bare ".env" -- hence ".env*" below.
config*.yaml
config*.yml
!config.example.yaml
*creds*.json
*credential*.json
service-account*.json
.env*
*.env
*.pem
*.key

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- R -------------------------------------------------------------------
.Rproj.user
.Rhistory
.RData
.Ruserdata

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Regenerable local data ------------------------------------------------
# Equivalence snapshots: large, and rebuilt from the pipeline on demand.
Data/Equivalence/
# The local data store the app reads. Rebuilt by `python -m Scripts.refresh`,
# and a lineups.parquet is ~235 x 469 per league-season.
Data/Store/
# nflverse usage pulls, rebuilt by `Rscript R/GetUsage.R` -- ~3.5 MB a season and
# regenerable in seconds. Listed by filename rather than as Data/NFL/*/ because
# Data/NFL/2025/NFL_Stats.csv is committed. Data/NFL/player_ids.parquet is
# committed too, and is not season-scoped, so it is unaffected either way.
Data/NFL/*/opportunity.parquet
Data/NFL/*/player_weeks.parquet
Data/NFL/*/usage_meta.json
